# Archivos de VS Code / IDEs
.vscode/
.idea/
*.code-workspace

# Archivos de sistema y temporales
.DS_Store
Thumbs.db

# Entornos virtuales de Python
.venv/
venv/
ENV/
env/

# Archivos del backend que no se deben subir
backend/certs/
backend/.env
backend/node_modules/

# Archivos del frontend (si usás React/Vite)
frontend/.env*
frontend/node_modules/
frontend/dist/
frontend/build/

# MQTT logs si están fuera de `log/`
*.log

# Archivos de debugging
*.pid
*.log.*

# Otros
*.bak
*.swp

# Portfolio
portfolio/node_modules/
portfolio/dist/

