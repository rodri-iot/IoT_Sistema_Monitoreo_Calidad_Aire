# Configuración para mqtt/generate_certs_v2.sh (copiar a .env.local)

# Host del broker tal como lo ven los clientes. En Docker Compose: el nombre del servicio.
# Para nodos físicos en la red local usar la IP o el DNS del equipo que corre Mosquitto.
MQTT_HOST=mqtts://mosquitto:8883

CERT_DAYS=365

# Identidades a emitir (CN de cada certificado de cliente).
# backend_smca es obligatorio: es la identidad del backend ante el broker.
DEVICES="backend_smca nodo01 nodo02 nodo03"

# Datos X.509
C=AR
ST=CABA
L=CABA
O=FIUBA
